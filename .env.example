# ==========================================
# StudentHub - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# IMPORTANT: .env is in .gitignore and will NEVER be pushed to GitHub!
# ==========================================

# Database Settings
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=studenthub

# Application Secrets & API Keys
APP_ENV=development
APP_KEY=your_secret_app_key_here
API_SECRET=your_api_secret_key_here
